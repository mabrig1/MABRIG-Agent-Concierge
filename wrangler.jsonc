{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mabrig-agent-concierge-pilot",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-11-13",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "mabrig-concierge-pilot", "database_id": "REPLACE_WITH_SEPARATE_D1_DATABASE_ID", "migrations_dir": "db" }
  ]
}